# Secrets. Nothing in this app needs one, and the release is unsigned -- but a
# signing key or a token that lands here should not be one `git add .` away from
# being published.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets.json
