node_modules/
dist/
*.log

# pnpm keeps its store in the home directory by default; this catches the
# in-repo layout a `store-dir` setting or a container can produce.
.pnpm-store/

# Rust / Tauri
/src-tauri/target/
/src-tauri/gen/

# generated app icons (regenerate with: pnpm tauri icon)
