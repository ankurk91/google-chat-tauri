{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Chat",
  "mainBinaryName": "google-chat-tauri",
  "version": "0.0.2",
  "identifier": "com.ankurk91.google-chat-tauri",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "remote-chat"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "nsis"
    ],
    "category": "SocialNetworking",
    "publisher": "ankurk91",
    "shortDescription": "Unofficial desktop app for Google Chat",
    "longDescription": "Unofficial desktop wrapper for Google Chat with a tray icon, unread message counter and desktop notifications.",
    "copyright": "Copyright (c) ankurk91",
    "licenseFile": "../LICENSE.txt",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "depends": [
          "libssl3t64 | libssl3"
        ],
        "desktopTemplate": "deb/app.desktop",
        "postRemoveScript": "deb/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
