{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Chat",
  "mainBinaryName": "google-chat-tauri",
  "version": "1.0.0",
  "identifier": "com.ankurk91.google-chat-tauri",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default", "remote-chat"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "category": "SocialNetworking",
    "shortDescription": "Unofficial desktop app for Google Chat",
    "longDescription": "Unofficial desktop wrapper for Google Chat with a tray icon, unread message counter and desktop notifications.",
    "copyright": "Copyright (c) ankurk91",
    "licenseFile": "../LICENSE.txt",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
