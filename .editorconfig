# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
# rustfmt's default, and not negotiable: `cargo fmt --check` runs in CI.
indent_size = 4
max_line_length = 100

[*.{js,json,yml,yaml,html,css,toml}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
